{
  "name": "nexbots-platform",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name nexbots",
    "test": "node --test tests/*.test.js",
    "deploy:cleanup": "wrangler deploy --config cleanup/wrangler.toml"
  },
  "dependencies": {
    "firebase": "^12.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.2.0",
    "wrangler": "^4.46.0"
  }
}
