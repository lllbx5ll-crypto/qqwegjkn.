rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // KEYLESS MODE: Cloudflare verifies the Firebase ID token, then forwards it
    // to the Firestore REST API. Firestore Security Rules MUST authorize writes.
    // Do not replace this file with the old all-writes-denied service-account rules.
    function signedIn() { return request.auth != null; }
    function ownerEmail() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email == 'lllbx5ll@gmail.com';
    }
    function ownerDoc() { return /databases/$(database)/documents/config/owner; }
    function owner() {
      return ownerEmail() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid;
    }
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function registered() { return signedIn() && exists(userDoc(request.auth.uid)); }
    function user() { return get(userDoc(request.auth.uid)).data; }
    function blocked() {
      return registered() && user().get('bannedUntilMillis', null) != null
        && user().bannedUntilMillis > request.time.toMillis();
    }
    function permission(name) {
      return owner() || (registered() && !blocked() && user().role == 'developer'
        && name in user().permissions);
    }
    function dayUTC() { return int(request.time.toMillis() / 86400000); }
    function subscriptionActive() {
      return registered() && user().plan in ['plus', 'premium', 'pro']
        && user().get('planEndsAtMillis', null) != null
        && user().planEndsAtMillis > request.time.toMillis()
        && (user().get('planStartsAtMillis', null) == null
            || user().planStartsAtMillis <= request.time.toMillis());
    }
    function mayUpload() { return owner() || (registered() && !blocked() && subscriptionActive()); }
    function messageLimit() {
      return owner() ? 100000 :
        (subscriptionActive() ?
          (exists(/databases/$(database)/documents/config/plans) ?
            get(/databases/$(database)/documents/config/plans).data[user().plan].dailyMessages :
            (user().plan == 'plus' ? 150 : (user().plan == 'premium' ? 400 : 1000)))
          : 50);
    }
    function quotaPath(quotaId) { return /databases/$(database)/documents/quotas/$(quotaId); }
    function dlPath(quotaId) { return /databases/$(database)/documents/downloadQuotas/$(quotaId); }
    function projectPath(projectId) { return /databases/$(database)/documents/projects/$(projectId); }
    function dmMessagePath(messageId) { return /databases/$(database)/documents/dmMessages/$(messageId); }
    function usernamePath(handle) { return /databases/$(database)/documents/usernames/$(handle); }
    function storyPath(storyId) { return /databases/$(database)/documents/stories/$(storyId); }
    function threadPath(threadId) { return /databases/$(database)/documents/dmThreads/$(threadId); }
    function userBlockPath(blocker,blockedUid) { return /databases/$(database)/documents/userBlocks/$(blocker + '_' + blockedUid); }
    function canDM(a,b) { return registered() && !blocked() && a != b &&
      !exists(userBlockPath(a,b)) && !exists(userBlockPath(b,a)); }
    function memberThread(id) { return registered() && !blocked()
      && exists(threadPath(id)) && request.auth.uid in get(threadPath(id)).data.members; }
    function inThread(id) { return memberThread(id)
      && canDM(request.auth.uid,
         get(threadPath(id)).data.members[0] == request.auth.uid ?
           get(threadPath(id)).data.members[1] : get(threadPath(id)).data.members[0]); }
    function messagePath(messageId) { return /databases/$(database)/documents/messages/$(messageId); }
    function followPath(uid,target) { return /databases/$(database)/documents/profileFollows/$(uid + '_' + target); }
    function likePath(uid,target) { return /databases/$(database)/documents/profileLikes/$(uid + '_' + target); }
    // A social counter may change only in the same atomic commit as the
    // corresponding edge creation/deletion by the signed-in actor.
    function socialCountUpdate(uid,counter,relationPath) {
      return registered() && !blocked() && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([counter])
        && request.resource.data[counter] is int && request.resource.data[counter] >= 0
        && (
          (!exists(relationPath) && existsAfter(relationPath)
            && getAfter(relationPath).data.actorUid == request.auth.uid
            && getAfter(relationPath).data.targetUid == uid
            && request.resource.data[counter] == resource.data.get(counter,0)+1)
          ||
          (exists(relationPath) && !existsAfter(relationPath)
            && request.resource.data[counter] == resource.data.get(counter,0)-1)
        );
    }

    match /config/{configId} {
      allow get: if configId in ['owner', 'public', 'plans', 'payment'];
      allow list: if false;
      allow create: if configId == 'owner' && ownerEmail()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if (configId == 'payment' && owner())
        || (configId == 'public' && permission('manageSettings'))
        || (configId == 'plans' && permission('managePlans')
          && request.resource.data.free.dailyMessages == 50
          && request.resource.data.free.canUpload == false);
      allow create: if (configId == 'payment' && owner())
        || (configId == 'public' && permission('manageSettings'))
        || (configId == 'plans' && permission('managePlans')
          && request.resource.data.free.dailyMessages == 50
          && request.resource.data.free.canUpload == false);
      allow delete: if false;
    }

    match /users/{uid} {
      allow get: if true; // emails are stored ONLY under privateUsers
      allow list: if permission('manageUsers') || permission('viewEmails');
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.plan == 'free'
        && request.resource.data.permissions == []
        && request.resource.data.role == (owner() ? 'owner' : 'user')
        && request.resource.data.verified == owner()
        && request.resource.data.get('planEndsAtMillis', null) == null
        && request.resource.data.get('username', '') == ''
        && request.resource.data.get('followersCount', 0) == 0
        && request.resource.data.get('likesCount', 0) == 0;
      allow update: if (
          signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'bio', 'avatar', 'cover', 'updatedAt','username'])
          && (request.resource.data.get('username','') == resource.data.get('username','') || (
            request.resource.data.username is string
            && request.resource.data.username.matches('^[a-z0-9_]{3,24}$')
            && existsAfter(usernamePath(request.resource.data.username))
            && getAfter(usernamePath(request.resource.data.username)).data.uid == uid
            && (resource.data.get('username','') == '' || !existsAfter(usernamePath(resource.data.username)))
          ))
          && !blocked()
        ) || (
          permission('manageUsers') && !(
            exists(ownerDoc()) && get(ownerDoc()).data.uid == uid
          )
          && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions']) ? owner() : true)
          && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'badgeType']) ? permission('manageBadges') : true)
          && request.resource.data.role in ['developer', 'user']
          && request.resource.data.plan in ['free', 'plus', 'premium', 'pro']
        ) || (
          // Owner-approved bank transfer: user plan changes are allowed ONLY
          // when the matching pending receipt is approved in this same commit.
          owner() && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'plan','planStartsAt','planStartsAtMillis','planEndsAt',
            'planEndsAtMillis','updatedAt','lastPaymentRequestId'])
          && request.resource.data.lastPaymentRequestId is string
          && exists(/databases/$(database)/documents/paymentRequests/$(request.resource.data.lastPaymentRequestId))
          && get(/databases/$(database)/documents/paymentRequests/$(request.resource.data.lastPaymentRequestId)).data.status == 'pending'
          && getAfter(/databases/$(database)/documents/paymentRequests/$(request.resource.data.lastPaymentRequestId)).data.status == 'approved'
          && getAfter(/databases/$(database)/documents/paymentRequests/$(request.resource.data.lastPaymentRequestId)).data.userUid == uid
          && getAfter(/databases/$(database)/documents/paymentRequests/$(request.resource.data.lastPaymentRequestId)).data.plan == request.resource.data.plan
          && getAfter(/databases/$(database)/documents/paymentRequests/$(request.resource.data.lastPaymentRequestId)).data.reviewedBy == request.auth.uid
        ) || (
          owner() && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'verified', 'updatedAt'])
          && request.resource.data.role == 'owner' && request.resource.data.verified == true
        ) || socialCountUpdate(uid,'followersCount',followPath(request.auth.uid,uid))
          || socialCountUpdate(uid,'likesCount',likePath(request.auth.uid,uid));
      allow delete: if false;
    }

    match /profileFollows/{edgeId} {
      allow get: if signedIn() && edgeId.matches('^' + request.auth.uid + '_.*');
      allow list: if false;
      allow create: if registered() && !blocked()
        && request.resource.data.keys().hasOnly(['actorUid','targetUid','createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && edgeId == request.auth.uid + '_' + request.resource.data.targetUid
        && exists(userDoc(request.resource.data.targetUid))
        && getAfter(userDoc(request.resource.data.targetUid)).data.followersCount ==
          get(userDoc(request.resource.data.targetUid)).data.get('followersCount',0)+1;
      allow delete: if signedIn() && registered() && !blocked()
        && resource.data.actorUid == request.auth.uid
        && getAfter(userDoc(resource.data.targetUid)).data.followersCount ==
          get(userDoc(resource.data.targetUid)).data.get('followersCount',0)-1;
      allow update: if false;
    }
    match /profileLikes/{edgeId} {
      allow get: if signedIn() && edgeId.matches('^' + request.auth.uid + '_.*');
      allow list: if false;
      allow create: if registered() && !blocked()
        && request.resource.data.keys().hasOnly(['actorUid','targetUid','createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && edgeId == request.auth.uid + '_' + request.resource.data.targetUid
        && exists(userDoc(request.resource.data.targetUid))
        && getAfter(userDoc(request.resource.data.targetUid)).data.likesCount ==
          get(userDoc(request.resource.data.targetUid)).data.get('likesCount',0)+1;
      allow delete: if signedIn() && registered() && !blocked()
        && resource.data.actorUid == request.auth.uid
        && getAfter(userDoc(resource.data.targetUid)).data.likesCount ==
          get(userDoc(resource.data.targetUid)).data.get('likesCount',0)-1;
      allow update: if false;
    }

    match /privateUsers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || permission('viewEmails'));
      allow list: if permission('viewEmails');
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email', 'createdAt']);
      allow update, delete: if false;
    }

    match /projects/{projectId} {
      allow get: if (resource == null && registered())
        || resource.data.status == 'approved'
        || (registered() && (resource.data.authorId == request.auth.uid || permission('manageProjects')));
      // Queries need a WHERE status == approved, WHERE authorId == uid,
      // or admin permission. Firestore rules never filter queries automatically.
      allow list: if resource.data.status == 'approved'
        || (registered() && resource.data.authorId == request.auth.uid)
        || permission('manageProjects');
      allow create: if mayUpload() && !blocked()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.get('forSale',false) is bool
        && request.resource.data.get('price',0) is number
        && request.resource.data.get('price',0) >= 0
        && request.resource.data.get('price',0) <= 10000
        && request.resource.data.get('currency','USD') == 'USD'
        && request.resource.data.downloads == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 90
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20
        && request.resource.data.description.size() <= 2500
        && request.resource.data.category in ['whatsapp', 'telegram', 'python', 'javascript', 'php', 'tools']
        && request.resource.data.keys().hasOnly([
          'title','description','category','language','tags','usage','externalUrl','imageKey','fileKey',
          'originalFileName','forSale','price','currency','authorId','authorName','authorAvatar','status','reviewReason','downloads','createdAt','updatedAt'
        ])
        && (request.resource.data.fileKey == null
          || request.resource.data.fileKey == 'projects/' + projectId + '/file')
        && (request.resource.data.imageKey == null
          || request.resource.data.imageKey == 'projects/' + projectId + '/cover');
      allow update: if permission('manageProjects') || (
        signedIn() && registered() && !blocked() && resource.data.status == 'approved'
        && request.resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads','lastDownloadId'])
        && request.resource.data.downloads == resource.data.downloads + 1
        && request.resource.data.lastDownloadId == request.auth.uid + '_' + projectId + '_' + string(dayUTC())
        && getAfter(dlPath(request.resource.data.lastDownloadId)).data.uid == request.auth.uid
        && getAfter(dlPath(request.resource.data.lastDownloadId)).data.projectId == projectId
        && getAfter(dlPath(request.resource.data.lastDownloadId)).data.count <= 30
        && getAfter(dlPath(request.resource.data.lastDownloadId)).data.count ==
          (exists(dlPath(request.resource.data.lastDownloadId)) ?
            get(dlPath(request.resource.data.lastDownloadId)).data.count + 1 : 1)
      );
      allow delete: if permission('manageProjects') || (registered() && !blocked() && resource.data.authorId == request.auth.uid);
    }

    match /downloadQuotas/{quotaId} {
      allow get: if signedIn() && quotaId.matches('^' + request.auth.uid + '_.*');
      allow list: if false;
      allow create, update: if signedIn() && registered() && !blocked()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day == dayUTC()
        && request.resource.data.projectId is string
        && quotaId == request.auth.uid + '_' + request.resource.data.projectId + '_' + string(dayUTC())
        && request.resource.data.count is int
        && request.resource.data.count > 0 && request.resource.data.count <= 30
        && request.resource.data.count == (resource == null ? 1 : resource.data.count + 1)
        && request.resource.data.keys().hasOnly(['uid','projectId','day','count'])
        && getAfter(projectPath(request.resource.data.projectId)).data.lastDownloadId == quotaId
        && getAfter(projectPath(request.resource.data.projectId)).data.downloads ==
            get(projectPath(request.resource.data.projectId)).data.downloads + 1;
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow get, list: if registered() && !blocked();
      allow create: if registered() && !blocked()
        && !(user().get('chatMutedUntilMillis', null) != null
          && user().chatMutedUntilMillis > request.time.toMillis())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == user().role
        && request.resource.data.displayName == user().displayName
        && request.resource.data.avatar == user().avatar
        && request.resource.data.verified == user().verified
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600
        && request.resource.data.deleted == false
        && request.resource.data.quotaId == request.auth.uid + '_' + string(dayUTC())
        && getAfter(quotaPath(request.resource.data.quotaId)).data.lastMessageId == messageId
        && getAfter(quotaPath(request.resource.data.quotaId)).data.count == request.resource.data.quotaCount;
      allow update: if permission('manageChat')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','deleted'])
        && request.resource.data.deleted == true;
      allow delete: if false;
    }

    match /quotas/{quotaId} {
      allow get: if signedIn() && quotaId == request.auth.uid + '_' + string(dayUTC());
      allow list: if false;
      allow create, update: if registered() && !blocked()
        && quotaId == request.auth.uid + '_' + string(dayUTC())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day == dayUTC()
        && request.resource.data.count is int
        && request.resource.data.count == (resource == null ? 1 : resource.data.count + 1)
        && request.resource.data.count <= messageLimit()
        && request.resource.data.keys().hasOnly(['uid','day','count','updatedAt','lastMessageId'])
        && ((existsAfter(messagePath(request.resource.data.lastMessageId))
          && getAfter(messagePath(request.resource.data.lastMessageId)).data.uid == request.auth.uid
          && getAfter(messagePath(request.resource.data.lastMessageId)).data.quotaId == quotaId
          && getAfter(messagePath(request.resource.data.lastMessageId)).data.quotaCount == request.resource.data.count)
          || (existsAfter(dmMessagePath(request.resource.data.lastMessageId))
          && getAfter(dmMessagePath(request.resource.data.lastMessageId)).data.uid == request.auth.uid
          && getAfter(dmMessagePath(request.resource.data.lastMessageId)).data.quotaId == quotaId
          && getAfter(dmMessagePath(request.resource.data.lastMessageId)).data.quotaCount == request.resource.data.count));
      allow delete: if false;
    }

    // A bank receipt is only a pending request; ONLY the owner can approve it.
    // The requester's authenticated identity must match the stored account.
    match /paymentRequests/{requestId} {
      allow get: if owner() || (registered() && !blocked() && resource != null && resource.data.userUid == request.auth.uid);
      allow list: if owner() || (registered() && !blocked()
        && request.query.limit <= 100 && resource.data.userUid == request.auth.uid);
      allow create: if registered() && !blocked()
        && request.resource.data.keys().hasOnly(['userUid','userName','plan','currency','amount','account','receiptKey','mime','paymentMethod','status','createdAt','reviewedAt','reviewedBy','rejectionReason'])
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.userName == user().displayName
        && request.resource.data.plan in ['plus','premium','pro']
        && request.resource.data.currency in ['YER','SAR','USD']
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.receiptKey == 'payment-receipts/' + request.auth.uid + '/' + requestId
        && request.resource.data.mime in ['image/png','image/jpeg','image/webp']
        && request.resource.data.createdAt is string
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null;
      allow update: if owner()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status','reviewedAt','reviewedBy','rejectionReason'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }

    match /audit/{auditId} {
      allow get, list: if owner();
      allow create: if registered() && !blocked()
        && (owner() || permission('manageProjects') || permission('manageChat')
          || permission('manageUsers') || permission('managePlans') || permission('manageSettings')
          || permission('manageBadges'))
        && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by','action','target','createdAt']);
      allow update, delete: if false;
    }


    // Public username claim is transactional with the user's profile, unique
    // by document ID. Do not store private email addresses here.
    match /usernames/{handle} {
      allow get: if registered() && !blocked();
      allow list: if false;
      allow create: if registered() && !blocked()
        && handle.matches('^[a-z0-9_]{3,24}$')
        && request.resource.data.keys().hasOnly(['uid','handle','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle == handle
        && getAfter(userDoc(request.auth.uid)).data.username == handle;
      allow delete: if registered() && !blocked()
        && resource.data.uid == request.auth.uid
        && getAfter(userDoc(request.auth.uid)).data.get('username','') != handle;
      allow update: if false;
    }

    match /userBlocks/{edgeId} {
      // Absent block edges must return NOT_FOUND, not PERMISSION_DENIED.
      allow get: if registered() && !blocked()
        && (edgeId.matches('^' + request.auth.uid + '_.*')
          || edgeId.matches('^.*_' + request.auth.uid + '$'));
      allow list: if false;
      allow create: if registered() && !blocked()
        && request.resource.data.keys().hasOnly(['actorUid','targetUid','createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.targetUid != request.auth.uid
        && exists(userDoc(request.resource.data.targetUid))
        && edgeId == request.auth.uid + '_' + request.resource.data.targetUid;
      allow delete: if registered() && !blocked() && resource.data.actorUid == request.auth.uid;
      allow update: if false;
    }

    // Only participants may see private chat data; blocking in either direction
    // disables sending AND opening that conversation until unblocked.
    match /dmThreads/{threadId} {
      // Existing threads remain readable even when one participant blocks
      // the other; blocking prevents NEW messages, not reading history.
      allow get: if registered() && !blocked()
        && request.auth.uid in resource.data.members
        && resource.data.members.size() == 2;
      allow list: if registered() && !blocked()
        && request.auth.uid in resource.data.members
        && request.query.limit <= 100;
      allow create: if registered() && !blocked()
        && request.resource.data.keys().hasOnly(['members','createdBy','createdAt','lastText','lastMessageAt','lastMessageId','unreadCounts'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lastText == ''
        && request.resource.data.lastMessageId == ''
        && request.resource.data.unreadCounts is map
        && request.resource.data.unreadCounts.keys().hasOnly(request.resource.data.members)
        && request.resource.data.unreadCounts.size() == 2
        && request.resource.data.unreadCounts[request.resource.data.members[0]] == 0
        && request.resource.data.unreadCounts[request.resource.data.members[1]] == 0
        && exists(userDoc(request.resource.data.members[0]))
        && exists(userDoc(request.resource.data.members[1]))
        && canDM(request.resource.data.members[0],request.resource.data.members[1]);
      allow update: if inThread(threadId)
        && request.resource.data.unreadCounts is map
        && request.resource.data.unreadCounts.keys().hasOnly(resource.data.members)
        && request.resource.data.unreadCounts.size() == 2
        && (
          // Sending: only the recipient's unread counter may increase, by 1,
          // as part of the same commit as the new message and quota record.
          (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastText','lastMessageAt','lastMessageId','unreadCounts'])
           && existsAfter(dmMessagePath(request.resource.data.lastMessageId))
           && getAfter(dmMessagePath(request.resource.data.lastMessageId)).data.threadId == threadId
           && getAfter(dmMessagePath(request.resource.data.lastMessageId)).data.uid == request.auth.uid
           && request.resource.data.lastMessageId != resource.data.lastMessageId
           && !exists(dmMessagePath(request.resource.data.lastMessageId))
           && request.resource.data.lastText is string
           && request.resource.data.lastText.size() <= 100
           && request.resource.data.unreadCounts[request.auth.uid]
              == resource.data.get('unreadCounts', {}).get(request.auth.uid, 0)
           && request.resource.data.unreadCounts[resource.data.members[0] == request.auth.uid ? resource.data.members[1] : resource.data.members[0]]
              == resource.data.get('unreadCounts', {}).get(resource.data.members[0] == request.auth.uid ? resource.data.members[1] : resource.data.members[0], 0) + 1)
          ||
          // Reading: a participant can only LOWER their own counter.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCounts'])
           && request.resource.data.unreadCounts[request.auth.uid] is int
           && request.resource.data.unreadCounts[request.auth.uid] >= 0
           && request.resource.data.unreadCounts[request.auth.uid]
              <= resource.data.get('unreadCounts', {}).get(request.auth.uid, 0)
           && request.resource.data.unreadCounts[resource.data.members[0] == request.auth.uid ? resource.data.members[1] : resource.data.members[0]]
              == resource.data.get('unreadCounts', {}).get(resource.data.members[0] == request.auth.uid ? resource.data.members[1] : resource.data.members[0], 0))
        );
      allow delete: if false;
    }
    match /dmMessages/{messageId} {
      allow get, list: if memberThread(resource.data.threadId);
      allow create: if registered() && !blocked()
        && inThread(request.resource.data.threadId)
        && request.resource.data.keys().hasOnly(['threadId','uid','recipientUid','text','createdAt','readAt','quotaId','quotaCount'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.recipientUid in get(threadPath(request.resource.data.threadId)).data.members
        && request.resource.data.readAt == null
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600
        && request.resource.data.quotaId == request.auth.uid + '_' + string(dayUTC())
        && getAfter(quotaPath(request.resource.data.quotaId)).data.lastMessageId == messageId
        && getAfter(quotaPath(request.resource.data.quotaId)).data.count == request.resource.data.quotaCount
        && getAfter(threadPath(request.resource.data.threadId)).data.lastMessageId == messageId;
      allow update: if memberThread(resource.data.threadId)
        && resource.data.recipientUid == request.auth.uid
        && resource.data.readAt == null
        && request.resource.data.readAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow get, list: if permission('manageUsers');
      allow create: if registered() && !blocked()
        && request.resource.data.keys().hasOnly(['reporterUid','reporterName','targetUid','targetName','reason','status','createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid != request.auth.uid
        && exists(userDoc(request.resource.data.targetUid))
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && request.resource.data.reason.size() <= 400
        && request.resource.data.reporterName == user().displayName
        && request.resource.data.targetName == get(userDoc(request.resource.data.targetUid)).data.displayName
        && request.resource.data.status == 'open';
      allow update: if permission('manageUsers')
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status','reviewerUid','reviewedAt','reason'])
        && request.resource.data.status in ['open','resolved','dismissed'];
      allow delete: if false;
    }

    // Stories expire precisely for visibility; TTL cleanup is eventual.
    // expiresAt is a proper Firestore timestamp, not a string.
    match /stories/{storyId} {
      // Story media is requested by a browser <img>/<video> without an ID token.
      // Public reads apply to ACTIVE stories only; list queries must prove it.
      allow get: if (resource == null && registered()) || resource.data.expiresAt > request.time;
      allow list: if (registered() && !blocked() && request.query.limit <= 100
        && (resource.data.expiresAt > request.time || resource.data.ownerUid == request.auth.uid))
        || (resource.data.expiresAt <= request.time && request.query.limit <= 100);
      allow create: if mayUpload()
        && request.resource.data.keys().hasOnly(['ownerUid','type','text','mediaKey','mime','createdAt','expiresAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.type in ['text','image','video']
        && request.resource.data.text is string && request.resource.data.text.size() <= 600
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24,'h')
        && request.resource.data.mediaKey is string
        && (request.resource.data.type == 'text' && request.resource.data.mediaKey == '' ||
           request.resource.data.type != 'text' && request.resource.data.mediaKey == 'stories/' + storyId + '/media');
      allow delete: if (registered() && !blocked()
        && (resource.data.ownerUid == request.auth.uid || owner()))
        || resource.data.expiresAt <= request.time;
      allow update: if false;
    }
    match /storyViews/{viewId} {
      allow get: if registered() && !blocked()
        && viewId.matches('^' + request.auth.uid + '_.*');
      allow list: if (registered() && !blocked() && resource.data.ownerUid == request.auth.uid)
        || (resource.data.expiresAt <= request.time && request.query.limit <= 100);
      allow create: if registered() && !blocked()
        && request.resource.data.keys().hasOnly(['actorUid','ownerUid','storyId','expiresAt','createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && viewId == request.auth.uid + '_' + request.resource.data.storyId
        && exists(storyPath(request.resource.data.storyId))
        && get(storyPath(request.resource.data.storyId)).data.expiresAt > request.time
        && request.resource.data.expiresAt == get(storyPath(request.resource.data.storyId)).data.expiresAt
        && request.resource.data.ownerUid == get(storyPath(request.resource.data.storyId)).data.ownerUid;
      allow update: if false;
      allow delete: if resource.data.expiresAt <= request.time;
    }
    match /storyLikes/{likeId} {
      allow get: if registered() && !blocked()
        && likeId.matches('^' + request.auth.uid + '_.*');
      allow list: if (registered() && !blocked() && resource.data.ownerUid == request.auth.uid)
        || (resource.data.expiresAt <= request.time && request.query.limit <= 100);
      allow create: if registered() && !blocked()
        && request.resource.data.keys().hasOnly(['actorUid','ownerUid','storyId','expiresAt','createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.storyId
        && exists(storyPath(request.resource.data.storyId))
        && get(storyPath(request.resource.data.storyId)).data.expiresAt > request.time
        && request.resource.data.expiresAt == get(storyPath(request.resource.data.storyId)).data.expiresAt
        && request.resource.data.ownerUid == get(storyPath(request.resource.data.storyId)).data.ownerUid;
      allow delete: if (registered() && !blocked() && resource.data.actorUid == request.auth.uid)
        || resource.data.expiresAt <= request.time;
      allow update: if false;
    }

    // A seller grants a named buyer access after completing a manual sale.
    match /purchaseGrants/{grantId} {
      // A buyer can check their own non-existing grant without a 403.
      allow get: if registered() && !blocked()
        && (grantId.matches('^.*_' + request.auth.uid + '$')
          || (resource != null && resource.data.sellerUid == request.auth.uid)
          || permission('manageProjects'));
      allow list: if false;
      allow create: if registered() && !blocked()
        && request.resource.data.keys().hasOnly(['projectId','buyerUid','sellerUid','grantedBy','createdAt'])
        && grantId == request.resource.data.projectId + '_' + request.resource.data.buyerUid
        && exists(projectPath(request.resource.data.projectId))
        && request.resource.data.sellerUid == get(projectPath(request.resource.data.projectId)).data.authorId
        && (request.auth.uid == request.resource.data.sellerUid || permission('manageProjects'))
        && request.resource.data.grantedBy == request.auth.uid;
      allow update, delete: if false;
    }
    match /projectEdits/{projectId} {
      // Allow project authors to probe for a pending edit even if not yet created.
      allow get: if registered() && !blocked()
        && (permission('manageProjects') ||
            (exists(projectPath(projectId))
              && get(projectPath(projectId)).data.authorId == request.auth.uid));
      allow list: if permission('manageProjects');
      allow create: if registered() && !blocked()
        && exists(projectPath(projectId))
        && request.resource.data.authorId == request.auth.uid
        && get(projectPath(projectId)).data.authorId == request.auth.uid
        && request.resource.data.projectId == projectId
        && request.resource.data.status == 'pending'
        && request.resource.data.changes is map
        && request.resource.data.changes.keys().hasOnly(['title','description','category','language','usage','tags','externalUrl','forSale','price','currency']);
      allow update: if (registered() && !blocked()
         && resource.data.authorId == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['changes','status','createdAt'])
         && request.resource.data.status == 'pending'
         && request.resource.data.changes.keys().hasOnly(['title','description','category','language','usage','tags','externalUrl','forSale','price','currency']))
         || permission('manageProjects');
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
